FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY requirements-live.txt requirements.txt ./
RUN pip install --no-cache-dir -r requirements-live.txt
COPY engine.py execution.py ./
COPY live/ live/
RUN mkdir -p /data
# Render persistent disks are mounted at runtime; their ownership may differ
# from ownership set during the Docker build. Keep the single-instance process
# able to write its SQLite ledger on the mounted volume.
EXPOSE 10000
CMD ["sh","-c","exec uvicorn live.service:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
